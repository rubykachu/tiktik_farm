# Login URL cho luồng đăng nhập TikTok qua Selenium / noVNC (tiktok_uploader/tiktok.py).
# Đây là biến DUY NHẤT được đọc từ .env (qua load_dotenv).
# Mọi config khác:
#   - config.txt              → đường dẫn uploader legacy (Config class đọc trực tiếp)
#   - docker-compose.yml / shell env → biến runtime của API + scheduler v2
# Xem .env.example để biết danh sách biến v2.
TIKTOK_LOGIN_URL=https://www.tiktok.com/login

# Local LLM (Ollama) — optional. Activate in Settings → Local mode.
# Install: curl -fsSL https://ollama.com/install.sh | sh && ollama pull llama3.2
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://host.docker.internal:11434

BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=rubykachu
