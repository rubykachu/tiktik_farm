# Copy to .env and adjust as needed.

# Used by the CLI login flow (undetected-chromedriver) and by the noVNC
# control server when launching Chromium.
TIKTOK_LOGIN_URL=https://www.tiktok.com/login

# ---- API / scheduler (Docker compose reads these via the environment: blocks,
# but you can also set them here for local non-Docker runs.) ----

# Path to the SQLite file. Defaults to /data/tiktok.db inside containers,
# ./data/tiktok.db for local runs.
# TIKTOK_API_DB_PATH=/data/tiktok.db

# Path to the legacy uploader config (Config class). Default ./config.txt.
# TIKTOK_CONFIG_PATH=./config.txt

# Override the Fernet key file used to encrypt LLM keys / Douyin cookies at rest.
# Default: data/.secret_key (auto-generated, mode 600). Back this file up.
# TIKTOK_SECRET_KEY_FILE=data/.secret_key

# How often the scheduler polls for due jobs (seconds).
# SCHEDULER_POLL_SECONDS=30

# Scheduler worker concurrency. Default 1 (serial).
# Each extra worker uses ~70-80MB RAM. Safe values: 2-3 on 2GB, 5-8 on 4GB.
# SCHEDULER_CONCURRENCY=1

# Hard timeout for a single pipeline run (seconds). Over → emergency finalize
# + Telegram notify, tick ends. Default 1800.
# MAX_PIPELINE_SECONDS=1800

# Tmp dir for YouTube pipeline video downloads. Default: system /tmp (tmpfs = eats RAM).
# Set to a real-disk path to avoid RAM pressure when running concurrent pipelines.
# PIPELINE_TMP_DIR=/data/pipeline_tmp

# Tmp dir for Douyin pipeline video downloads. Default: {tmp}/douyin_tmp.
# DOUYIN_TMP_DIR=/data/douyin_tmp

# Log level for the scheduler service.
# LOG_LEVEL=INFO

# Local LLM (Ollama) — optional. Activate in Settings → Local mode.
# Install: curl -fsSL https://ollama.com/install.sh | sh && ollama pull llama3.2
# OLLAMA_MODEL=llama3.2:latest
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Public hostname for this deployment (set automatically by restart.sh).
# Allows requests from this origin through the CSRF origin check middleware.
# Accepts hostname or full URL (https:// prefix added if missing).
# Port the webapp is published on (host side). The API derives its allowed
# CSRF origin from this, so changing it here alone is not enough — the mapping
# in docker-compose.yml has to match.
# WEBAPP_PORT=2705

# HOST=your-tunnel.trycloudflare.com

# Public address used to build Telegram download links. Falls back to HOST.
# Leave unset for a local-only install; without it, video_mode=link degrades
# to a text-only notification.
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# Escape hatch for YouTube extraction breakage. Leave unset: yt-dlp picks its
# own clients per release, and upgrading yt-dlp is the real fix. Only set this
# when a release is broken and no newer one exists yet.
# YTDLP_PLAYER_CLIENTS=tv,web_safari

# HTTP Basic Auth for the webapp (nginx in prod, Vite dev server in dev).
# Required when exposing via a public tunnel (e.g. cloudflared).
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=changeme
